// Gold Flows Levels — يرسم مستويات منصة «تدفقات الذهب» على الشارت.
// الاستعمال: انسخ سطر المستويات من المنصة (قسم «فلتر الاتجاه الإحصائي» ← «انسخ المستويات»)
// ثم الصقه في خانة «Levels code» في إعدادات المؤشر. يرسم مناطق التجمّع (كل منطقة تجمع مستويات متقاربة)،
// والمستويات المنفردة اختيارية. يعمل على GC1! وMGC1! مباشرة، وعلى XAUUSD يُزاح كل شيء تلقائيًا بفرق إغلاق
// الأمس بين GC1! والسعر الفوري. لا حاجة لحذف السطر القديم: الصق الجديد تحته والمؤشر يأخذ الأحدث. ويرسم MA21.
//@version=6
indicator("Gold Flows Levels", shorttitle = "GF Levels", overlay = true, max_lines_count = 100, max_labels_count = 100, max_boxes_count = 20)

code      = input.text_area("", "Levels code", tooltip = "الصق سطر المنصة هنا. لا حاجة لحذف القديم: المؤشر يأخذ أحدث سطر GFL2 تلقائيًا، فالصق الجديد تحت القديم. لاستبدال الكل: حدّد الكل (Ctrl+A) ثم الصق.")
hideCode  = input.bool(false, "Clear: hide all platform levels", tooltip = "يخفي كل المستويات والمناطق دون حذف النص المحفوظ.")
basisMode = input.string("Auto", "Price basis", options = ["Auto", "Off", "Manual"], tooltip = "Auto: على XAUUSD تُزاح المستويات بفرق إغلاق أمس بين GC1! والسعر الفوري، ويبقى ثابتًا طوال اليوم. Off: بلا إزاحة. Manual: فرق تكتبه أنت.")
manualOff = input.float(0.0, "Manual offset (GC − chart)", step = 0.1)
showZones = input.bool(true, "Confluence zones")
onlyFable = input.bool(false, "Only Claude's zones (★)")
zoneText  = input.bool(true, "Zone labels")
showLines = input.bool(false, "Individual levels (lines)")
showCoded = input.bool(true, "Coded levels: each level with its zone", tooltip = "يكتب كل مستوى باسمه وسعره ورقم منطقته (Z1…)، و«—» لمستوى خارج المناطق.")
showGex   = input.bool(true, "  · GEX: Zero Gamma, Walls, Strikes")
showSig   = input.bool(false, "  · σ bands")
showPrior = input.bool(true, "  · Previous day / week high-low")
showMa    = input.bool(true, "  · MA50 / MA200")
showVp    = input.bool(true, "  · Volume Profile: POC / VAH / VAL / single prints")
cSup      = input.color(color.new(#4C7DD9, 0), "Support zone color")
cRes      = input.color(color.new(#D9534F, 0), "Resistance zone color")
cPiv      = input.color(color.new(#FF9800, 0), "Pivot zone color")
showTable = input.bool(true, "Status table")
showMa21  = input.bool(true, "MA21")
ma21Type  = input.string("EMA", "MA21 type", options = ["EMA", "SMA"])
ma21Len   = input.int(21, "MA21 length", minval = 1)
cMa21     = input.color(color.new(#F5CE6B, 0), "MA21 color")

cGex   = input.color(color.new(#A970FF, 0), "GEX color")
cSig   = input.color(color.new(#9AA4B2, 0), "σ color")
cPrior = input.color(color.new(#E0B44C, 0), "Prior high/low color")
cMa    = input.color(color.new(#4C9AFF, 0), "MA color")
cVp    = input.color(color.new(#26C6DA, 0), "Volume Profile color")

// الفرق يُحسب من إغلاق الأمس للرمزين، فيبقى ثابتًا طوال الجلسة. (الحساب اللحظي كان يجعل المستويات تتحرك مع السعر،
// لأن بيانات GC1! في TradingView مؤجلة غالبًا بينما XAUUSD لحظي، فيتغير الفرق مع كل حركة.)
gcPrev = request.security("COMEX:GC1!", "D", close[1], lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
spPrev = request.security(syminfo.tickerid, "D", close[1], lookahead = barmerge.lookahead_on)
isSpot = str.contains(syminfo.ticker, "XAU")
float basis = basisMode == "Manual" ? manualOff : (basisMode == "Auto" and isSpot and not na(gcPrev) and not na(spPrev)) ? gcPrev - spPrev : 0.0

grp(string k) =>
    string g = "gex"
    if str.startswith(k, "U") or str.startswith(k, "D")
        g := "sig"
    if k == "PDH" or k == "PDL" or k == "PWH" or k == "PWL"
        g := "prior"
    if str.startswith(k, "MA")
        g := "ma"
    if k == "POC" or k == "VAH" or k == "VAL" or k == "WPOC" or k == "SP"
        g := "vp"
    g

nameOf(string k) =>
    switch k
        "ZG"  => "Zero Gamma"
        "CW"  => "Call Wall"
        "PW"  => "Put Wall"
        "P2"  => "Put #2"
        "P3"  => "Put #3"
        "C2"  => "Call #2"
        "C3"  => "Call #3"
        "U1"  => "+1σ"
        "D1"  => "−1σ"
        "U15" => "+1.5σ"
        "D15" => "−1.5σ"
        "U2"  => "+2σ"
        "D2"  => "−2σ"
        "PDH" => "PDH"
        "PDL" => "PDL"
        "PWH" => "PWH"
        "PWL" => "PWL"
        "WPOC" => "Weekly POC"
        "SP"  => "Single prints"
        => k

var array<line>  lns = array.new<line>()
var array<label> lbs = array.new<label>()
var array<box>   bxs = array.new<box>()
var table tb = table.new(position.top_right, 2, 7, bgcolor = color.new(#0B1220, 15), border_color = color.new(#9AA4B2, 70), border_width = 1)

if barstate.islast
    for l in lns
        line.delete(l)
    for l in lbs
        label.delete(l)
    for b in bxs
        box.delete(b)
    array.clear(lns)
    array.clear(lbs)
    array.clear(bxs)
    table.clear(tb, 0, 0, 1, 6)

    // أحدث سطر GFL2 في الخانة (يسمح بلصق الجديد تحت القديم دون حذف)
    string best = ""
    float bestD = -1.0
    if not hideCode
        for seg in str.split(code, "GFL2|")
            string t = str.trim(seg)
            if str.length(t) > 10
                float dn = str.tonumber(str.replace_all(array.get(str.split(t, "|"), 0), "-", ""))
                if not na(dn) and dn > bestD
                    bestD := dn
                    best := "GFL2|" + t
    parts = str.split(best, "|")
    bool ok = array.size(parts) >= 6 and array.get(parts, 0) == "GFL2"
    if ok
        // معرّف كل منطقة (Z1…) أول اسم في قائمة أعضائها، ومنه خريطة: المستوى ← منطقته
        map<string, string> zoneOf = map.new<string, string>()
        if array.size(parts) >= 7 and str.length(array.get(parts, 6)) > 0
            for z in str.split(array.get(parts, 6), ",")
                zf = str.split(z, ":")
                if array.size(zf) >= 5
                    zm = str.split(array.get(zf, 4), "+")
                    string zid0 = ""
                    if array.size(zf) >= 6
                        zid0 := array.get(zf, 5)
                    else if array.size(zm) > 0
                        string m0 = array.get(zm, 0)
                        if str.match(m0, "^Z[0-9]+$") != ""
                            zid0 := m0
                    if str.length(zid0) > 0
                        for m in zm
                            if m != zid0
                                map.put(zoneOf, m, zid0)
        // المستويات: كل مستوى باسمه وسعره ورقم منطقته، و«—» إن لم يقع في منطقة
        for t in (showLines or showCoded ? str.split(array.get(parts, 5), ";") : array.new<string>())
            kv = str.split(t, "=")
            if array.size(kv) == 2
                string k = array.get(kv, 0)
                vs = str.split(array.get(kv, 1), "@")
                float v = str.tonumber(array.get(vs, 0))
                string zid = "—"
                if array.size(vs) == 2
                    zid := array.get(vs, 1)
                else if map.contains(zoneOf, k)
                    zid := map.get(zoneOf, k)
                string g = grp(k)
                bool show = g == "gex" ? showGex : g == "sig" ? showSig : g == "prior" ? showPrior : g == "vp" ? showVp : showMa
                if show and not na(v)
                    float y = v - basis
                    color c = g == "gex" ? cGex : g == "sig" ? cSig : g == "prior" ? cPrior : g == "vp" ? cVp : cMa
                    string sty = g == "sig" ? line.style_dotted : g == "ma" ? line.style_dashed : line.style_solid
                    int w = k == "ZG" or k == "CW" or k == "PW" ? 2 : 1
                    string lab = nameOf(k) + "  " + str.tostring(y, "#.0") + "  · " + zid
                    if showCoded
                        array.push(lbs, label.new(bar_index + 3, y, lab, style = label.style_label_left, color = color.new(color.black, 100), textcolor = c, size = size.small))
                    if showLines
                        array.push(lns, line.new(bar_index - 1, y, bar_index, y, extend = extend.both, color = c, style = sty, width = w))
        // مناطق التجمّع: lo-hi:الوزن:الدور:اختيار Claude:Zn+الأعضاء
        if showZones and array.size(parts) >= 7 and str.length(array.get(parts, 6)) > 0
            for z in str.split(array.get(parts, 6), ",")
                f = str.split(z, ":")
                if array.size(f) >= 5
                    rng = str.split(array.get(f, 0), "-")
                    bool fav = array.get(f, 3) == "1"
                    if array.size(rng) == 2 and (fav or not onlyFable)
                        float lo = str.tonumber(array.get(rng, 0)) - basis
                        float hi = str.tonumber(array.get(rng, 1)) - basis
                        if not na(lo) and not na(hi)
                            string role = array.get(f, 2)
                            color zc = role == "S" ? cSup : role == "R" ? cRes : cPiv
                            string zid = ""
                            string names = ""
                            for m in str.split(array.get(f, 4), "+")
                                if str.length(zid) == 0 and str.length(names) == 0 and str.match(m, "^Z[0-9]+$") != ""
                                    zid := m
                                else
                                    names += (str.length(names) > 0 ? " · " : "") + nameOf(m)
                            if array.size(f) >= 6
                                zid := array.get(f, 5)
                            string tag = zoneText ? (str.length(zid) > 0 ? zid + "  " : "") + (fav ? "★ " : "") + names + "  (" + array.get(f, 1) + ")" : ""
                            array.push(bxs, box.new(math.max(0, bar_index - 300), hi, bar_index + 25, lo, border_color = color.new(zc, fav ? 0 : 50), border_width = fav ? 2 : 1, extend = extend.right, bgcolor = color.new(zc, fav ? 70 : 85), text = tag, text_size = size.small, text_color = color.new(zc, 0), text_halign = text.align_right))

    if showTable
        table.cell(tb, 0, 0, "Gold Flows", text_color = #F5CE6B, text_size = size.small)
        if not ok
            table.cell(tb, 1, 0, hideCode ? "المستويات مخفية" : "الصق سطر المستويات", text_color = hideCode ? color.gray : #EF5350, text_size = size.small)
        else
            string d = array.get(parts, 1)
            dp = str.split(d, "-")
            bool stale = false
            if array.size(dp) == 3
                int codeT  = timestamp("UTC", int(str.tonumber(array.get(dp, 0))), int(str.tonumber(array.get(dp, 1))), int(str.tonumber(array.get(dp, 2))), 0, 0)
                int todayT = timestamp("UTC", year(timenow, "UTC"), month(timenow, "UTC"), dayofmonth(timenow, "UTC"), 0, 0)
                int gap = math.round((todayT - codeT) / 86400000)
                int dw = dayofweek(timenow, "UTC")
                int allowed = dw == dayofweek.monday ? 3 : dw == dayofweek.sunday ? 2 : 1
                stale := gap > allowed
            string rg = array.get(parts, 2)
            string ed = array.get(parts, 3)
            string gm = array.get(parts, 4)
            table.cell(tb, 1, 0, stale ? "قديمة: انسخ الجديدة" : "محدّثة", text_color = stale ? #EF5350 : #26A69A, text_size = size.small)
            table.cell(tb, 0, 1, "التاريخ", text_color = color.gray, text_size = size.small)
            table.cell(tb, 1, 1, d, text_color = color.white, text_size = size.small)
            table.cell(tb, 0, 2, "النظام", text_color = color.gray, text_size = size.small)
            table.cell(tb, 1, 2, rg == "up" ? "صاعد" : rg == "down" ? "هابط" : "مختلط", text_color = rg == "up" ? #26A69A : rg == "down" ? #EF5350 : #FF9800, text_size = size.small)
            table.cell(tb, 0, 3, "الميزة", text_color = color.gray, text_size = size.small)
            table.cell(tb, 1, 3, ed == "long" ? "ميزة Long" : "لا ميزة", text_color = color.white, text_size = size.small)
            table.cell(tb, 0, 4, "Gamma", text_color = color.gray, text_size = size.small)
            table.cell(tb, 1, 4, gm == "pos" ? "موجبة" : gm == "neg" ? "سالبة" : "—", text_color = color.white, text_size = size.small)
            table.cell(tb, 0, 5, "الإزاحة", text_color = color.gray, text_size = size.small)
            table.cell(tb, 1, 5, str.tostring(basis, "#.0"), text_color = color.white, text_size = size.small)

// MA21 على رمز الشارت نفسه (لا يحتاج إزاحة)
ma21 = ma21Type == "EMA" ? ta.ema(close, ma21Len) : ta.sma(close, ma21Len)
plot(showMa21 ? ma21 : na, "MA21", color = cMa21, linewidth = 2)
